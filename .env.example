# Template of .env (spec 13.1). Copy to .env (git-ignored) and fill in. Foundry also loads .env:
# every value containing spaces must be double-quoted, and notes go on their own lines.

# ---- network ----
# NETWORK: anvil | base_sepolia
NETWORK=anvil
ANVIL_RPC_URL=http://127.0.0.1:8545
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# second provider for log indexing (recommended)
BASE_SEPOLIA_RPC_URL_2=
# final value: the public raw URL of evidence/base_sepolia/ (decide before 17 Oct)
EVIDENCE_BASE_URI=evidence/base_sepolia/
# default: %USERPROFILE%\.foundry\bin
ACB_FOUNDRY_BIN=
# default: runs/<run_id>/out/<network>/
ACB_OUT_DIR=

# ---- keys (leave empty on anvil). Base Sepolia: put a testnet mnemonic here once, quoted,
# ---- then run `acb keys init --network base_sepolia`, which replaces it with the lines below.
ACB_MNEMONIC=""
DEPLOYER_PRIVATE_KEY=
OWNER_PRIVATE_KEY=
ADMIN_PRIVATE_KEY=
AGENT_SIGNER_PRIVATE_KEY=
AGENT_SIGNER_NEXT_PRIVATE_KEY=
BUREAU_PRIVATE_KEY=
AUTONOMY_PRIVATE_KEY=
SIM_ATLAS_PRIVATE_KEY=
SIM_SLOWPOKE_PRIVATE_KEY=
SIM_GHOST_PRIVATE_KEY=
SIM_BLASTER_PRIVATE_KEY=
SIM_ORION_PRIVATE_KEY=
SIM_NOVA_PRIVATE_KEY=
SIM_BEACON_PRIVATE_KEY=
SIM_BEACON_OWNER_PRIVATE_KEY=
SIM_ECHO1_PRIVATE_KEY=
SIM_ECHO2_PRIVATE_KEY=
SIM_ECHO3_PRIVATE_KEY=
SIM_ATTACKER_PRIVATE_KEY=

# ---- local service tokens (random 32+ chars; `acb keys init` fills them) ----
SIGNER_TOKEN=
AGENT_TOKEN=
AGENT_ADMIN_TOKEN=
BUREAU_TOKEN=
AUTONOMY_TOKEN=
SIM_TOKEN=
EVENTS_TOKEN=
OWNER_UI_PASSWORD=
SESSION_SECRET=

# ---- LLM ----
# LLM_MODE: mock | openai | auto
LLM_MODE=auto
# e.g. https://api.deepseek.com or https://api.openai.com/v1 (empty: OpenAI)
LLM_BASE_URL=
# provider model id, verify on day 1 (empty with OpenAI: gpt-5.4-mini)
LLM_MODEL=
# empty: falls back to OPENAI_API_KEY when the provider is OpenAI
LLM_API_KEY=
# OPENAI_API_KEY=
LLM_TIMEOUT_S=20
# LLM_TOOL_MODE: native | json
LLM_TOOL_MODE=native
# JSON passed as extra_body (e.g. to disable a thinking mode)
LLM_EXTRA_BODY={}
MOCK_LLM_SCRIPT=config/mock_llm/default.yaml
# MOCK_LLM_PERSONA: careful | naive
MOCK_LLM_PERSONA=careful
# 1 only for scenario and attack runs
ACB_ALLOW_LLM_SWITCH=0

# ---- ports ----
OWNER_PORT=8700
AGENT_PORT=8701
SIGNER_PORT=8702
BUREAU_PORT=8703
SIM_PORT=8704
AUTONOMY_PORT=8705
